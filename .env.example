# 椋炰功搴旂敤閰嶇疆
# 鑾峰彇鏂瑰紡锛歨ttps://open.feishu.cn/app
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_USER_ID=your_user_id_here

# 璇存槑锛?# 1. FEISHU_APP_ID: 椋炰功搴旂敤鐨?App ID
# 2. FEISHU_APP_SECRET: 椋炰功搴旂敤鐨?App Secret
# 3. FEISHU_USER_ID: 鎺ユ敹娑堟伅鐨勭敤鎴稩D锛坥pen_id 鎴?user_id锛?#
# 浣跨敤鏂规硶锛?# 1. 澶嶅埗姝ゆ枃浠朵负 .env
# 2. 濉叆鐪熷疄鐨勯涔﹀簲鐢ㄥ嚟璇?# 3. .env 鏂囦欢涓嶄細琚彁浜ゅ埌git锛堝凡鍦?gitignore涓厤缃級

# Feishu custom bot webhook (sync / interactive card). Full URL only in local .env, never commit.
# FEISHU_SYNC_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token-here
# Per-module hooks (override defaults in src/tools/feishu/webhook/qudao_notify.py)
# FEISHU_WEBHOOK_PINDUODUO=https://open.feishu.cn/open-apis/bot/v2/hook/your-pdd-bot
# If bot enables "keyword" security: set keyword to match Feishu bot settings (or leave unset to use default 拼多多)
# FEISHU_WEBHOOK_PINDUODUO_KEYWORD=拼多多

# 拼多多：同步订单地址只处理「订单时间」在最近 N 天内的行（默认 2，最大 90）
# PINDUODUO_ADDRESS_SYNC_RECENT_DAYS=2
# 可选：list_records 按该列降序（新单优先，便于早停翻页）；列名须与多维表格一致，错误时自动改无排序
# PINDUODUO_ADDRESS_SYNC_SORT_FIELD=订单时间

# 拼多多：库存同步（飞书 ERP → 库存信息表 + 扣减日志），有代码内默认 table_id，仅当与你们表不一致时取消注释修改
# PINDUODUO_FEISHU_INVENTORY_INFO_TABLE_ID=tbljLwzLLKafXl0h
# PINDUODUO_FEISHU_INVENTORY_LOG_TABLE_ID=tblXXipFcgH1EQH7

# ── MySQL 数据库（安特限时秒杀等模块）────────────────────────────
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USERNAME=your_db_user
DB_DATABASE=your_db_name
DB_PASSWORD=your_db_password

# ── AI 大脑：LLM 简单问答（OpenAI 兼容接口）──────────────────────# 用于文本分析等轻量 AI 任务（库存关联匹配已改用 Cursor，见下方）
# 支持 DMXAPI / DeepSeek / 阿里云百炼 / 任意 OpenAI 兼容接口
AI_BASE_URL=https://www.dmxapi.cn/v1
AI_API_KEY=your_ai_api_key_here
AI_STOCK_LINK_MODEL=qwen-flash-2025-07-28

# ── AI 大脑：Cursor SDK Agent（复杂任务 + 浏览器控制 + 拼多多库存 AI 匹配）──
# 获取 API Key：https://cursor.com/dashboard/api
CURSOR_API_KEY=your_cursor_api_key_here
# 推荐模型（默认 composer-2.5，也可用 claude-4 等）
CURSOR_MODEL=composer-2.5
