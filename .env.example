# 椋炰功搴旂敤閰嶇疆
# 鑾峰彇鏂瑰紡锛歨ttps://open.feishu.cn/app
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_USER_ID=your_user_id_here

# 璇存槑锛?# 1. FEISHU_APP_ID: 椋炰功搴旂敤鐨?App ID
# 2. FEISHU_APP_SECRET: 椋炰功搴旂敤鐨?App Secret
# 3. FEISHU_USER_ID: 鎺ユ敹娑堟伅鐨勭敤鎴稩D锛坥pen_id 鎴?user_id锛?#
# 浣跨敤鏂规硶锛?# 1. 澶嶅埗姝ゆ枃浠朵负 .env
# 2. 濉叆鐪熷疄鐨勯涔﹀簲鐢ㄥ嚟璇?# 3. .env 鏂囦欢涓嶄細琚彁浜ゅ埌git锛堝凡鍦?gitignore涓厤缃級

# Feishu custom bot webhook (sync / interactive card). Full URL only in local .env, never commit.
# FEISHU_SYNC_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token-here
# Per-module hooks (override defaults in src/tools/feishu/webhook/qudao_notify.py)
# FEISHU_WEBHOOK_PINDUODUO=https://open.feishu.cn/open-apis/bot/v2/hook/your-pdd-bot
# If bot enables "keyword" security: set keyword to match Feishu bot settings (or leave unset to use default 拼多多)
# FEISHU_WEBHOOK_PINDUODUO_KEYWORD=拼多多

# 拼多多：同步订单地址只处理「订单时间」在最近 N 天内的行（默认 2，最大 90）
# PINDUODUO_ADDRESS_SYNC_RECENT_DAYS=2
# 可选：list_records 按该列降序（新单优先，便于早停翻页）；列名须与多维表格一致，错误时自动改无排序
# PINDUODUO_ADDRESS_SYNC_SORT_FIELD=订单时间

# 拼多多：库存同步（飞书 ERP → 库存信息表 + 扣减日志），有代码内默认 table_id，仅当与你们表不一致时取消注释修改
# PINDUODUO_FEISHU_INVENTORY_INFO_TABLE_ID=tbljLwzLLKafXl0h
# PINDUODUO_FEISHU_INVENTORY_LOG_TABLE_ID=tblXXipFcgH1EQH7

# ── 拼多多桌面客户端 Cookie 复用（实验性，默认关）──────────────────
# 桌面端 PddWebWorkbench 是 Chromium 内核，User Data 默认在公共文档。
# 实测：webview 无 PASS_ID（原生宿主注入鉴权），仅复制 cookie 无法免扫码，故默认 0。
# 保留代码：后续可走「共享 profile」方案再启用。
# PDD_DESKTOP_COOKIE_IMPORT=0
# PDD_DESKTOP_USER_DATA_DIR=C:\Users\Public\Documents\PDD\PddBrowser104\User Data
# PDD_DESKTOP_PROFILE=cs_xxxxxxxx（留空则自动挑最近活跃且含 ERP 登录态的 profile）

# ── MySQL 数据库（安特限时秒杀等模块）────────────────────────────
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USERNAME=your_db_user
DB_DATABASE=your_db_name
DB_PASSWORD=your_db_password

# ── 安特 PC 商城登录（Playwright 自动登录门禁）──────────────────
# 未登录访问 homepage 会跳到 /login；浏览器采集/搜索前会自动用密码登录
ANTEXIADAN_USERNAME=your_phone_or_account
ANTEXIADAN_PASSWORD=your_password
# 登录后「安全验证」滑块：Nest /ai/chat 识图（需 NEST_DEVICE_KEY）
# ANTEXIADAN_CAPTCHA_MAX_ATTEMPTS=5
# Nest 返回距离后拖动前叠加（默认 -5，略修正偏长）
# ANTEXIADAN_CAPTCHA_DRAG_OFFSET_PX=-5
# Nest 识图后删除本地截图（默认删；联调保留样本可设 0/false）
# ANTEXIADAN_CAPTCHA_DELETE_SCREENSHOTS=1
# 预售抢购：开售前多少分钟加入购物车（默认 20）
# ANTEXIADAN_PRESALE_CART_ADVANCE_MIN=20
# 安特专用 Webhook（不配则回退 FEISHU_SYNC_WEBHOOK_URL）；若机器人开了关键词校验，正文会带「安特」
# FEISHU_WEBHOOK_ANTEXIADAN=https://open.feishu.cn/open-apis/bot/v2/hook/your-token
# FEISHU_WEBHOOK_ANTEXIADAN_KEYWORD=安特
# 可选：直连 pcapi 时用的 key（浏览器采集可不配，会自动拦截）
# ANTEXI_API_KEY=your_pcapi_key
# ANTEXI_API_VERSION=20251218

# ── Banana Agent AI（全项目 ask / ask_vision / run_agent / 滑块 / 库存匹配）────
# 一次问答模式，鉴权：Authorization: Bearer <AK>
# AK 在 bananain 管理端生成（形如 ak_xxx）
BANANA_AI_AK=ak_4dfaf338972e17d7d17e4c2f.ctKWRlm9LuMidywKBcnF3LoA43nGa_VZuNNA8g5exR4
# 默认根路径（含 /ali-oss/api/v1）；如需切换环境可覆盖：
BANANA_AI_API_BASE=https://test-sso.bananain.cn/ali-oss/api/v1
# 多模态请求超时（秒），默认 300
# BANANA_AI_TIMEOUT_MULTIMODAL=300

# ── Nest CMS REST（保留：nest_client 其他用途；AI 已迁移至 Banana Agent）────
# 推荐生产（安特滑块 /ai/chat 已联调完成）：
NEST_API_BASE=https://nestapi.xfysj.top/xcx/api/v1
# 本地 Nest 联调：
# NEST_API_BASE=http://localhost:8080/api/v1
# NEST_DEVICE_KEY=keyId.secret
# 或 NEST_USERNAME= / NEST_PASSWORD= ；短期调试可用 NEST_JWT=（须为 eyJ 开头的 access JWT，勿填 device key）

# ── 可选：直连 OpenAI 兼容接口（旧代码路径；ask() 已默认走 Banana Agent）──
# AI_BASE_URL=https://www.dmxapi.cn/v1
# AI_API_KEY=your_ai_api_key_here
# AI_STOCK_LINK_MODEL=qwen-flash-2025-07-28
# AI_VISION_MODEL=gpt-4o-mini
